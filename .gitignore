node_modules/
.DS_Store
*.log

# Nothing here holds secrets today — real config and keys live in the OS
# application-support directory, not the repo — but these are the shapes that
# would carry them if the layout ever changed.
secrets.json
server-token
models.json
.env

# TLS material fetched from Tailscale for local HTTPS. These are private keys
# for this machine's own hostname and must never be committed.
*.key
*.crt
*.pem

# Python bytecode from the launcher helper scripts.
__pycache__/
*.pyc

# Per-machine pairing credentials generated by setup.
.orchestrator-node.env
nodes.json

.launcher/

/Launch Distributed Orchestrator.app/

# This repository is public and ships only the app. Reports, audits, reviews,
# handoffs and prompts stay out of it: keep them in .do-notes/, which Git ignores.
# The name patterns catch one saved anywhere else in the tree by mistake.
/.do-notes/
*HANDOFF*.md
*handoff*.md
*HARDENING*.md
*hardening*.md
*DOSSIER*.md
*dossier*.md
*LEDGER*.md
*ledger*.md
*AUDIT*.md
*audit*.md
*REVIEW*.md
*-review*.md
*PROMPT*.md
*-prompt*.md
